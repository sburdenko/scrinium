<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scrinium.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Scrinium.Desktop/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <FontFamily x:Key="AppFont">avares://Scrinium.Desktop/Assets/Fonts#Archivo, Inter</FontFamily>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Scrinium.Desktop/Styles/Palette.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Scrinium.Desktop/Styles/Palette.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock, SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    </Style>
    <Style Selector="TextBlock.failed">
      <Setter Property="Foreground" Value="{DynamicResource Blue}" />
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="LetterSpacing" Value="1.04" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="LetterSpacing" Value="0.96" />
      <Setter Property="Foreground" Value="{DynamicResource Blue}" />
    </Style>
    <Style Selector="TextBlock.question">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="LineHeight" Value="36" />
      <Setter Property="LetterSpacing" Value="-0.48" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button, ToggleButton">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" Margin="-4" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.primary, Button.secondary">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InkTint7}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InkTint14}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTint10}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTint18}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="Button.primary:disabled, Button.secondary:disabled, Button.ghost:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon.small">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="Button.icon:not(.primary)">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:not(.primary):pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InkTint7}" />
    </Style>

    <Style Selector="Button.row, Button.cell, Button.pager">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.cell">
      <Setter Property="Padding" Value="12,12,12,14" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.pager">
      <Setter Property="Padding" Value="24,14" />
      <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.cell:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pager:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InkTint4}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.cell:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.pager:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InkTint7}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.row.open /template/ ContentPresenter#PART_ContentPresenter, Button.cell.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="Button.cell TextBlock.number">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.cell.active TextBlock.number">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Highlight}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_PlaceholderText">
      <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkBorderHover}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBox:pointerover, TextBox:focus">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <Style Selector="TextBox.composer">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="0,8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement, TextBox.composer:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkBorderHover}" />
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#Background, ComboBox:focused /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource Line}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource InkFaint}" />
    </Style>

    <Style Selector="Path.icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource Ink}" />
    </Style>
  </Application.Styles>
</Application>
