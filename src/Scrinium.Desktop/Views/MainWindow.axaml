<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scrinium.Desktop.ViewModels"
        xmlns:views="using:Scrinium.Desktop.Views"
        xmlns:ws="using:Scrinium.Core.Workspaces"
        x:Class="Scrinium.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Scrinium"
        Icon="avares://Scrinium.Desktop/Assets/Icon/scrinium.png"
        Width="1320" Height="820" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid x:Name="Frame" RowDefinitions="56,Auto,*,Auto" ColumnDefinitions="280,*,420" Background="Transparent">
    <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,0,2">
      <Grid ColumnDefinitions="280,*,420">
        <Border Grid.Column="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,2,0" Padding="20,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Viewbox Width="20" Height="20">
              <Canvas Width="100" Height="100">
                <Rectangle Width="100" Height="100" Fill="#12243B" />
                <Path Data="M32 26 H22 V74 H32" Stroke="#F6EFC9" StrokeThickness="10" />
                <Path Data="M68 26 H78 V74 H68" Stroke="#F6EFC9" StrokeThickness="10" />
                <Path Data="M44 38 L54 32 V68" Stroke="#FFD60A" StrokeThickness="13" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Scrinium" FontSize="18" FontWeight="ExtraBold" LetterSpacing="-0.18"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="40,0,24,0">
          <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{Binding Active.Chat.SessionLine}" />
          <Button Grid.Column="1" Classes="secondary" Content="New question" VerticalAlignment="Center"
                  Command="{Binding NewQuestionCommand}" />
        </Grid>

        <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="2,0,0,0" Padding="24,0,16,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{Binding ModelLine}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="ghost" Content="Settings" VerticalAlignment="Center"
                    Command="{Binding ToggleSettingsCommand}" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <views:OllamaBanner Grid.Row="1" Grid.ColumnSpan="3" DataContext="{Binding Banner}" IsVisible="{Binding IsVisible}" />

    <Border x:Name="ArchiveColumn" Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,2,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="20,16,20,4">
          <TextBlock Classes="label" Text="WORKSPACE" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding !IsNamingWorkspace}">
            <ComboBox x:Name="WorkspacePicker" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Workspace">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="ws:Workspace">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Classes="secondary icon" ToolTip.Tip="New workspace"
                    AutomationProperties.Name="New workspace" Command="{Binding StartNamingWorkspaceCommand}">
              <Path Classes="icon" Data="{StaticResource IconPlus}" />
            </Button>
          </Grid>
          <StackPanel IsVisible="{Binding IsNamingWorkspace}" Spacing="8">
            <TextBox x:Name="WorkspaceName" PlaceholderText="Workspace name" Text="{Binding NewWorkspaceName}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding CreateWorkspaceCommand}" />
                <KeyBinding Gesture="Escape" Command="{Binding CancelNamingWorkspaceCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Create" Command="{Binding CreateWorkspaceCommand}" />
              <Button Classes="ghost" Content="Cancel" Command="{Binding CancelNamingWorkspaceCommand}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{Binding WorkspaceError}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Danger}"
                     IsVisible="{Binding WorkspaceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <views:ArchiveView DataContext="{Binding Active.Sources}" />
      </DockPanel>
    </Border>
    <views:ChatView Grid.Row="2" Grid.Column="1" DataContext="{Binding Active.Chat}" />
    <views:RightPanelView Grid.Row="2" Grid.Column="2" DataContext="{Binding Active.Panel}" />

    <DockPanel Grid.Row="3" Grid.ColumnSpan="3">
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Ink}" BorderThickness="0,2,0,0" Padding="12,2">
        <Button x:Name="DiagnosticsToggle" Classes="ghost" Content="Diagnostics" FontSize="13"
                AutomationProperties.Name="Diagnostics" Command="{Binding ToggleDiagnosticsCommand}" />
      </Border>
      <Border IsVisible="{Binding IsDiagnosticsOpen}" Height="240" BorderBrush="{DynamicResource Ink}" BorderThickness="0,2,0,0">
        <views:DiagnosticsPanelView DataContext="{Binding Active.Chat.Diagnostics}" />
      </Border>
    </DockPanel>
  </Grid>
</Window>
