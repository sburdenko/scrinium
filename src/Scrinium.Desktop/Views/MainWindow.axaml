<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scrinium.Desktop.ViewModels"
        xmlns:views="using:Scrinium.Desktop.Views"
        x:Class="Scrinium.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Scrinium"
        Icon="avares://Scrinium.Desktop/Assets/Icon/scrinium.png"
        Width="1320" Height="820" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid x:Name="Frame" RowDefinitions="56,Auto,*" ColumnDefinitions="280,*,420">
    <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,0,2">
      <Grid ColumnDefinitions="280,*,420">
        <Border Grid.Column="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,2,0" Padding="20,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Viewbox Width="20" Height="20">
              <Canvas Width="100" Height="100">
                <Rectangle Width="100" Height="100" Fill="#12243B" />
                <Path Data="M32 26 H22 V74 H32" Stroke="#F6EFC9" StrokeThickness="10" />
                <Path Data="M68 26 H78 V74 H68" Stroke="#F6EFC9" StrokeThickness="10" />
                <Path Data="M44 38 L54 32 V68" Stroke="#FFD60A" StrokeThickness="13" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Scrinium" FontSize="18" FontWeight="ExtraBold" LetterSpacing="-0.18"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="40,0,24,0">
          <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{Binding Chat.SessionLine}" />
          <Button Grid.Column="1" Classes="secondary" Content="New question" VerticalAlignment="Center"
                  Command="{Binding NewQuestionCommand}" />
        </Grid>

        <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="2,0,0,0" Padding="24,0,16,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{Binding ModelLine}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="ghost" Content="Settings" VerticalAlignment="Center"
                    Command="{Binding ToggleSettingsCommand}" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <views:OllamaBanner Grid.Row="1" Grid.ColumnSpan="3" DataContext="{Binding Banner}" IsVisible="{Binding IsVisible}" />

    <views:ArchiveView Grid.Row="2" Grid.Column="0" DataContext="{Binding Sources}" />
    <views:ChatView Grid.Row="2" Grid.Column="1" DataContext="{Binding Chat}" />
    <views:RightPanelView Grid.Row="2" Grid.Column="2" DataContext="{Binding Panel}" />
  </Grid>
</Window>
