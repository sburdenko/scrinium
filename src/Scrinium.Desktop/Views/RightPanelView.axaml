<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Scrinium.Desktop.ViewModels"
             xmlns:ctl="using:Scrinium.Desktop.Controls"
             x:Class="Scrinium.Desktop.Views.RightPanelView"
             x:DataType="vm:PanelHost">
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="2,0,0,0">
    <ContentControl Content="{Binding Current}">
      <ContentControl.DataTemplates>
        <DataTemplate x:DataType="vm:PreviewPanelViewModel">
          <Grid RowDefinitions="Auto,*,Auto,Auto">
            <Border Grid.Row="0" IsVisible="{Binding ShowsText}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,0,0,2" Padding="24,20,24,16">
              <StackPanel Spacing="6">
                <TextBlock Classes="kicker" Text="{Binding Kicker}" />
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="ExtraBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LocationLabel}" Classes="muted small"
                           IsVisible="{Binding LocationLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <Grid Grid.Row="1">
              <TextBlock IsVisible="{Binding IsEmpty}" Classes="muted" FontSize="14" TextWrapping="Wrap"
                         Margin="24" Text="Click a citation number to see the passage" />
              <TextBlock IsVisible="{Binding IsUnavailable}" Classes="muted" FontSize="14" TextWrapping="Wrap"
                         Margin="24" Text="The original is unavailable: the file was removed or cannot be read." />
              <ctl:HighlightedTextViewer IsVisible="{Binding ShowsText}"
                                         Before="{Binding Before}" Highlight="{Binding Highlight}"
                                         After="{Binding After}" />
            </Grid>

            <Border Grid.Row="2" IsVisible="{Binding HasPager}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,2,0,0">
              <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" Classes="pager" Command="{Binding PreviousCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{StaticResource IconArrowLeft}" />
                    <TextBlock Text="Previous" />
                  </StackPanel>
                </Button>
                <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                  <Button Classes="pager" Command="{Binding NextCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Next" />
                      <Path Classes="icon" Data="{StaticResource IconArrowRight}" />
                    </StackPanel>
                  </Button>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Row="3" IsVisible="{Binding CanOpenFile}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,1,0,0" Padding="20,10">
              <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding OpenOriginalCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Open file" Foreground="{DynamicResource Accent}" />
                  <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconExternalLink}"
                        Stroke="{DynamicResource Accent}" />
                </StackPanel>
              </Button>
            </Border>
          </Grid>
        </DataTemplate>

        <DataTemplate x:DataType="vm:SettingsPanelViewModel">
          <ScrollViewer>
            <StackPanel Margin="24,20,24,24" Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="SETTINGS" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon small" Command="{Binding CloseCommand}" ToolTip.Tip="Close settings">
                  <Path Classes="icon" Data="{StaticResource IconX}" />
                </Button>
              </Grid>

              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="ANSWER MODEL" />
                <ComboBox ItemsSource="{Binding ChatModels}" SelectedItem="{Binding ChatModel}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="EMBEDDING MODEL" />
                <ComboBox ItemsSource="{Binding EmbeddingModels}" SelectedItem="{Binding EmbeddingModel}" HorizontalAlignment="Stretch" />
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="After changing the embedding model, documents must be reindexed or search will not see them." />
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding ModelsNote}" Classes="muted small" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="Refresh" Command="{Binding RefreshModelsCommand}" />
              </Grid>

              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="OLLAMA ADDRESS" />
                <TextBox Text="{Binding OllamaUrl}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Save" IsEnabled="{Binding HasChanges}" Command="{Binding SaveCommand}" />
                <Button Classes="secondary" Content="Reindex everything" Command="{Binding ReindexAllCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding SavedNote}" Classes="muted small" TextWrapping="Wrap" />

              <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock Classes="label" Text="DATA FOLDER" />
                <TextBlock Text="{Binding DataDirectory}" Classes="muted small" TextWrapping="Wrap" />
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="The database and originals live here. To back up, copy this folder." />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Border>
</UserControl>
