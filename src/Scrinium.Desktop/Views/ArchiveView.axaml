<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Scrinium.Desktop.ViewModels"
             x:Class="Scrinium.Desktop.Views.ArchiveView"
             x:DataType="vm:SourcesViewModel"
             x:Name="Root">
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,2,0">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="10" Margin="20,16,20,12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="ARCHIVE" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Summary}" VerticalAlignment="Center" />
        </Grid>
        <TextBox PlaceholderText="Filter by name" Text="{Binding Filter}" />
      </StackPanel>

      <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,2,0,0">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SourceItemViewModel">
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <Button Classes="row" Classes.open="{Binding IsOpenInOriginal}"
                            AutomationProperties.Name="{Binding Title}"
                            Command="{Binding #Root.((vm:SourcesViewModel)DataContext).OpenCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8" Margin="20,9">
                        <TextBlock Text="{Binding NumberText}" FontSize="11" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource InkFaint}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding DetailText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                     Classes="muted" Classes.failed="{Binding IsFailed}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                          <Button Classes="icon small" ToolTip.Tip="Retry" AutomationProperties.Name="Retry" IsVisible="{Binding CanRetry}"
                                  Command="{Binding #Root.((vm:SourcesViewModel)DataContext).RetryCommand}"
                                  CommandParameter="{Binding}">
                            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconRotateCcw}"
                                  Stroke="{DynamicResource Accent}" />
                          </Button>
                          <Button Classes="icon small" ToolTip.Tip="Delete" AutomationProperties.Name="Delete"
                                  IsVisible="{Binding $parent[Button].IsPointerOver}"
                                  Command="{Binding #Root.((vm:SourcesViewModel)DataContext).DeleteCommand}"
                                  CommandParameter="{Binding}">
                            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconX}"
                                  Stroke="{DynamicResource InkMuted}" />
                          </Button>
                          <TextBlock Text="{Binding CitationMarks}" FontSize="11" FontWeight="ExtraBold"
                                     Foreground="{DynamicResource Blue}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel IsVisible="{Binding IsEmpty}" Spacing="6" Margin="20,24">
            <TextBlock Text="Nothing here yet" FontSize="16" FontWeight="ExtraBold" />
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
                       Text="Add .txt, .md or .pdf files. Everything stays on this computer." />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="2" Spacing="8" Margin="20,16">
        <Border BorderBrush="{DynamicResource Danger}" BorderThickness="2,0,0,0" Padding="12,8"
                IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" FontSize="13" />
            <Button Grid.Column="1" Classes="icon small" Command="{Binding DismissErrorCommand}" VerticalAlignment="Top"
                    AutomationProperties.Name="Dismiss">
              <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconX}" />
            </Button>
          </Grid>
        </Border>
        <Button Classes="primary" Command="{Binding AddFilesCommand}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Add files">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource OnAccent}"
                  Data="{StaticResource IconPlus}" />
            <TextBlock Text="Add files" Foreground="{DynamicResource OnAccent}" />
          </StackPanel>
        </Button>
        <TextBlock Classes="muted small" Text="or drop .txt, .md, .pdf anywhere" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
