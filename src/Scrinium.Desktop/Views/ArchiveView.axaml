<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Scrinium.Desktop.ViewModels"
             x:Class="Scrinium.Desktop.Views.ArchiveView"
             x:DataType="vm:SourcesViewModel"
             x:Name="Root">
  <Grid RowDefinitions="Auto,Auto,*" Margin="40,32,40,0" RowSpacing="20">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4" VerticalAlignment="Bottom">
        <TextBlock Classes="heading" Text="Archive" />
        <TextBlock Classes="muted" Text="{Binding Summary}" />
      </StackPanel>
      <TextBox Grid.Column="1" Width="240" Height="36" VerticalAlignment="Bottom"
               PlaceholderText="Filter by name" Text="{Binding Filter}" />
      <Button Grid.Column="2" Classes="secondary" Content="Retry failures" VerticalAlignment="Bottom"
              IsVisible="{Binding HasFailed}" Command="{Binding RetryFailedCommand}" />
      <Button Grid.Column="3" Classes="primary" VerticalAlignment="Bottom" Command="{Binding AddFilesCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Width="16" Height="16" Stroke="{DynamicResource OnAccent}"
                Data="{StaticResource IconPlus}" StrokeThickness="2.5" />
          <TextBlock Text="Add files" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource DangerSoft}" Padding="12,10"
            IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" Foreground="{DynamicResource DangerInk}" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding DismissErrorCommand}">
          <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconX}" Stroke="{DynamicResource DangerInk}" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1" Padding="0">
        <Grid ColumnDefinitions="*,70,120,170,220,48">
          <TextBlock Classes="muted" Text="DOCUMENT" FontSize="11" FontWeight="Bold" LetterSpacing="0.9" Margin="12,8" />
          <TextBlock Grid.Column="1" Classes="muted" Text="TYPE" FontSize="11" FontWeight="Bold" LetterSpacing="0.9" Margin="8" />
          <TextBlock Grid.Column="2" Classes="muted" Text="FILE DATE" FontSize="11" FontWeight="Bold" LetterSpacing="0.9" Margin="8" />
          <TextBlock Grid.Column="3" Classes="muted" Text="STATE" FontSize="11" FontWeight="Bold" LetterSpacing="0.9" Margin="8" />
          <TextBlock Grid.Column="4" Classes="muted" Text="DETAIL" FontSize="11" FontWeight="Bold" LetterSpacing="0.9" Margin="8" />
        </Grid>
      </Border>

      <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" Padding="0"
               SelectionMode="Single" IsVisible="{Binding !IsEmpty}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineFaint}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTint8}" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SourceItemViewModel">
            <Grid ColumnDefinitions="*,70,120,170,220,48" Background="Transparent">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,8" VerticalAlignment="Center">
                <Rectangle Classes="dot" Classes.ready="{Binding IsReady}" Classes.busy="{Binding IsBusy}"
                           Classes.stale="{Binding IsStale}" Classes.failed="{Binding IsFailed}" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding KindLabel}" FontSize="12" FontWeight="Bold"
                         VerticalAlignment="Center" Margin="8" />
              <TextBlock Grid.Column="2" Text="{Binding DateText}" Classes="muted" VerticalAlignment="Center" Margin="8" />
              <Border Grid.Column="3" Classes="tag" Margin="8"
                      Classes.ready="{Binding IsReady}" Classes.busy="{Binding IsBusy}"
                      Classes.stale="{Binding IsStale}" Classes.failed="{Binding IsFailed}">
                <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold" />
              </Border>
              <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="13" Margin="8"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Classes="muted" Classes.failedText="{Binding IsFailed}" />
              <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="icon" ToolTip.Tip="Retry" IsVisible="{Binding CanRetry}"
                        Command="{Binding #Root.((vm:SourcesViewModel)DataContext).RetryCommand}"
                        CommandParameter="{Binding}">
                  <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconRotateCcw}" Stroke="{DynamicResource Accent}" />
                </Button>
                <Button Classes="icon" ToolTip.Tip="Delete"
                        IsVisible="{Binding $parent[ListBoxItem].IsPointerOver}"
                        Command="{Binding #Root.((vm:SourcesViewModel)DataContext).DeleteCommand}"
                        CommandParameter="{Binding}">
                  <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconX}" Stroke="{DynamicResource InkMuted}" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="1" IsVisible="{Binding IsEmpty}" Spacing="6" Margin="12,28" HorizontalAlignment="Left">
        <TextBlock Text="Nothing here yet" FontSize="17" FontWeight="ExtraBold" />
        <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="460"
                   Text="Add .txt, .md or .pdf files. Everything stays on this computer." />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
