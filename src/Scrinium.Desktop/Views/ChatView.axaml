<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Scrinium.Desktop.ViewModels"
             xmlns:ctl="using:Scrinium.Desktop.Controls"
             x:Class="Scrinium.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             x:Name="Root">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="Scroller" Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="48,40,48,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="620" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="14">
          <TextBlock Classes="hero" Text="Ask your archive" />
          <TextBlock Classes="muted" FontSize="16" TextWrapping="Wrap"
                     Text="Every answer links to the sentence it came from. If your documents don't say, Scrinium tells you so." />
          <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="row" Command="{Binding #Root.((vm:ChatViewModel)DataContext).UseSuggestionCommand}"
                        CommandParameter="{Binding}">
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding}" FontSize="15" TextWrapping="Wrap" />
                      <Path Grid.Column="1" Classes="icon" Width="16" Height="16"
                            Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource Accent}" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ItemsControl x:Name="Messages" ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageViewModel">
              <Grid>
                <Border IsVisible="{Binding IsUser}" BorderBrush="{DynamicResource Line}"
                        Classes.ruled="{Binding ShowRuleAbove}" Margin="0,0,0,12">
                  <StackPanel Spacing="8" Margin="0,0,0,0">
                    <Border IsVisible="{Binding ShowRuleAbove}" Height="2" Background="{DynamicResource Line}" Margin="0,16,0,16" />
                    <TextBlock Classes="muted small" Text="{Binding MetaLine}" />
                    <TextBlock Classes="heading" Text="{Binding Text}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <StackPanel IsVisible="{Binding IsAssistant}" Spacing="14" Margin="0,0,0,24">
                  <TextBlock IsVisible="{Binding IsPending}" Text="{Binding StatusLine}" Classes="muted"
                             FontStyle="Italic" FontSize="14" />

                  <ctl:AnswerTextBlock IsVisible="{Binding IsTextVisible}" Answer="{Binding Text}"
                                       Citations="{Binding Citations}" ActiveNumber="{Binding ActiveCitationNumber}"
                                       TextWrapping="Wrap" FontSize="17" LineHeight="30"
                                       MarkerCommand="{Binding #Root.((vm:ChatViewModel)DataContext).OpenCitationCommand}" />

                  <TextBlock IsVisible="{Binding IsStopped}" Text="Stopped" Classes="muted small" />

                  <Border IsVisible="{Binding IsFailed}" Background="{DynamicResource DangerSoft}" Padding="10,12">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerInk}" />
                  </Border>

                  <Border IsVisible="{Binding HasStats}" BorderBrush="{DynamicResource Line}"
                          BorderThickness="0,2,0,0" Padding="0,10,0,0">
                    <TextBlock Classes="muted small" Text="{Binding StatsLine}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="48,12,48,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="620" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,0,2" Padding="0,8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="Prompt" Background="Transparent" BorderThickness="0" AcceptsReturn="True"
                   TextWrapping="Wrap" MaxHeight="150" FontSize="16" Padding="0,8"
                   PlaceholderText="Ask about your documents…" Text="{Binding Input}" />
          <Button Grid.Column="1" Classes="primary" Width="36" Height="36" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                  IsVisible="{Binding !IsBusy}" Command="{Binding SendCommand}" ToolTip.Tip="Send">
            <Path Classes="icon" Width="18" Height="18" Data="{StaticResource IconArrowUp}"
                  Stroke="{DynamicResource OnAccent}" StrokeThickness="2.5" />
          </Button>
          <Button Grid.Column="1" Classes="ghost" Content="Stop" VerticalAlignment="Bottom"
                  IsVisible="{Binding IsBusy}" Command="{Binding StopCommand}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
