<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Scrinium.Desktop.ViewModels"
             xmlns:ctl="using:Scrinium.Desktop.Controls"
             x:Class="Scrinium.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             x:Name="Root">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="Scroller" Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <StackPanel IsVisible="{Binding IsEmpty}" MaxWidth="560" Spacing="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,120,0,0">
          <TextBlock Text="Ask your archive" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                     Text="Every answer links to its sources. If the documents do not contain the answer, I will say so." />
          <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,3"
                        Command="{Binding #Root.((vm:ChatViewModel)DataContext).UseSuggestionCommand}"
                        CommandParameter="{Binding}">
                  <Border Classes="card" Padding="14,10" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding}" />
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Messages}" MaxWidth="780" Margin="24,20,24,12"
                      HorizontalAlignment="Stretch">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageViewModel">
              <Grid Margin="0,0,0,18">
                <Border IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="560"
                        Background="{DynamicResource AccentSoft}" CornerRadius="14,14,4,14" Padding="14,10">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </Border>

                <StackPanel IsVisible="{Binding IsAssistant}" Spacing="10">
                  <TextBlock IsVisible="{Binding IsPending}" Text="{Binding StatusLine}" Classes="muted" FontStyle="Italic" />

                  <ctl:AnswerTextBlock IsVisible="{Binding IsTextVisible}" Answer="{Binding Text}"
                                       Citations="{Binding Citations}" TextWrapping="Wrap" LineHeight="23"
                                       MarkerCommand="{Binding #Root.((vm:ChatViewModel)DataContext).OpenCitationCommand}" />

                  <TextBlock IsVisible="{Binding IsStopped}" Text="Stopped" Classes="muted small" />

                  <Border IsVisible="{Binding IsFailed}" Background="{DynamicResource DangerSoft}"
                          CornerRadius="10" Padding="12,10">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                  </Border>

                  <Expander IsVisible="{Binding HasCitations}" Padding="0" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsFinished}" Header="{Binding Citations.Count, StringFormat='Sources ({0})'}">
                    <ItemsControl ItemsSource="{Binding Citations}" Margin="0,6,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CitationViewModel">
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Padding="0" Margin="0,3"
                                  Command="{Binding #Root.((vm:ChatViewModel)DataContext).OpenCitationCommand}"
                                  CommandParameter="{Binding}">
                            <Border Classes="card" Padding="12,9" HorizontalAlignment="Stretch">
                              <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding DocumentTitle}" FontWeight="Medium" />
                                  <TextBlock Text="{Binding Subtitle}" Classes="muted small" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Preview}" Classes="muted small" TextWrapping="Wrap" MaxLines="2" />
                              </StackPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="1" Padding="24,0,24,20">
      <Border Classes="card" MaxWidth="780" Padding="10,8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="Prompt" BorderThickness="0" Background="Transparent" AcceptsReturn="True"
                   TextWrapping="Wrap" MaxHeight="150" PlaceholderText="Ask about your documents…"
                   Text="{Binding Input}" />
          <Button Grid.Column="1" Classes="primary" Content="Send" VerticalAlignment="Bottom"
                  IsVisible="{Binding !IsBusy}" Command="{Binding SendCommand}" />
          <Button Grid.Column="1" Classes="ghost" Content="Stop" VerticalAlignment="Bottom"
                  IsVisible="{Binding IsBusy}" Command="{Binding StopCommand}" />
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
