    { "id": "warranty-battery", "question": "What is the warranty on an e-bike battery?", "language": "en", "expect": "answer", "contains": ["500"], "cites": "warranty.md" },
    { "id": "warranty-chain", "question": "Is a worn chain covered by the warranty?", "language": "en", "expect": "answer", "contains": ["not|no"], "passage": ["chain"], "cites": "warranty.md" },

    { "id": "rent-ebike-day", "question": "How much is an e-bike per day?", "language": "en", "expect": "answer", "contains": ["39"], "cites": "rental-terms.md" },
