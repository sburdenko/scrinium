    { "id": "rent-late", "question": "What happens if I bring the rental bike back late?", "language": "en", "expect": "answer", "contains": ["10"], "cites": "rental-terms.md" },

    { "id": "faq-appointment", "question": "Brauche ich für eine Inspektion einen Termin?", "language": "de", "expect": "answer", "contains": ["ja|Termin"], "cites": "werkstatt-faq.md" },
