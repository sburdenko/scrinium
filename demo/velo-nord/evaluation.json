    { "id": "faq-pickup", "question": "Was kostet es, wenn Sie mein Fahrrad abholen?", "language": "de", "expect": "answer", "contains": ["15"], "cites": "werkstatt-faq.md" },
    { "id": "faq-card-ru", "question": "Можно ли у вас оплатить картой?", "language": "ru", "expect": "answer", "contains": ["Apple Pay|EC|кредит"], "passage": ["Karte|Apple Pay"], "cites": "werkstatt-faq.md" },

