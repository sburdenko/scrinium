    { "id": "refuse-skateboards", "question": "Do you sell skateboards?", "expect": "refusal" },
    { "id": "refuse-tyre-price", "question": "How much does a new tyre cost?", "expect": "refusal" },
    { "id": "refuse-insurance", "question": "Do you offer bike insurance?", "expect": "refusal" },
    { "id": "refuse-parking-de", "question": "Gibt es bei Ihnen Parkplätze für Autos?", "expect": "refusal" },
    { "id": "refuse-owner", "question": "Who owns Velo Nord?", "expect": "refusal" }
  ]
